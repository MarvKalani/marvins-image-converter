{
    "name": "Marvins Image Converter",
    "short_name": "Image-Converter",
    "start_url": "./app",
    "scope": "./",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#ffffff",
    "orientation": "any",
    "description": "Konvertieren Sie Ihre Bilder lokal und sicher.",
    "icons": [
        {
            "src": "./icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "./icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "share_target": {
        "action": "./app",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "allfiles",
                    "accept": [
                        "image/jpeg",
                        "image/png",
                        "image/gif",
                        "image/webp",
                        "image/avif",
                        "image/bmp",
                        "image/svg+xml",
                        "image/heic",
                        "image/heif",
                        ".jpg",
                        ".jpeg",
                        ".png",
                        ".gif",
                        ".webp",
                        ".avif",
                        ".bmp",
                        ".svg",
                        ".heic",
                        ".heif"
                    ]
                }
            ]
        }
    },
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "file_handlers": [
        {
            "action": "app",
            "accept": {
                "image/jpeg": [
                    ".jpg",
                    ".jpeg"
                ],
                "image/png": [
                    ".png"
                ],
                "image/webp": [
                    ".webp"
                ],
                "image/gif": [
                    ".gif"
                ],
                "image/avif": [
                    ".avif"
                ],
                "image/bmp": [
                    ".bmp"
                ],
                "image/heic": [
                    ".heic"
                ],
                "image/heif": [
                    ".heif"
                ],
                "image/svg+xml": [
                    ".svg"
                ],
                "image/tiff": [
                    ".tiff",
                    ".tif"
                ]
            }
        }
    ]
}